c RUN: %solver --anfread %s --anfwrite %t.anf --simplify 0 --verb 0
c RUN: test "$(grep -c '^x' %t.anf)" = 2
c RUN: grep -q 'x(1)\*x(2) + x(3)' %t.anf
c RUN: grep -q 'x(4) + x(5) + 1' %t.anf
c RUN: %solver --anfread %s --solve --allsol --verb 0 | %verify allsol %s
c
c A line listing the variables, as some ANF generators write, must not be
c read as the equation x1 + x2 + x3 + ... = 0: only two equations remain.
x1, x2, x3, x4, x5
x(1), x(2)
x1*x2 + x3
x4 + x5 + 1
