c RUN: gzip -c %s > %t.anf.gz
c RUN: %solver %t.anf.gz --allsol --verb 0 | %verify allsol %s
c RUN: %solver %t.anf.gz %t.cnf --verb 0 && %verify cnf %s %t.cnf
c RUN: %solver %t.anf.gz %t.out.anf --verb 0 && %solver %t.out.anf --allsol --verb 0 | %verify allsol %s
c
c A gzipped ANF input is read like a plain one.
x1*x2 + x3 + 1
x3*x4 + x2 + x5
x1 + x4 + x5*x2
