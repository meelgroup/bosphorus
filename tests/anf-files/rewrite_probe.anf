c RUN: %solver --anfread %s --anfwrite /dev/stdout --xl 0 --el 0 --sat 0 --binomred 0 --shorten 0 --prodsplit 0 | %OutputCheck %s
c RUN: %solver --anfread %s --solve --allsol --verb 0 | %verify allsol %s
c
c x1*x2 + x1 + 1 = 0 forces x1 = 1 and x2 = 0 (partial evaluation), and
c x7*x8*x9 + x7*x8 + 1 = x7*x8*(x9+1) + 1 forces x7 = x8 = 1, x9 = 0.
c x3*x4 + x3 (x3 -> x4) and x3*x4 + x4 (x4 -> x3) form a cycle in the
c implication graph, so x3 = x4.
c x5*x6 + x5 + x6 + 1 = 0 is the clause (x5 | x6) and x5*x6 = 0 is
c (-x5 | -x6); together they make x5 = x6 + 1, found through the SCCs.
x1*x2 + x1 + 1
x3*x4 + x3
x3*x4 + x4
x5*x6 + x5 + x6 + 1
x5*x6
x7*x8*x9 + x7*x8 + 1
c CHECK: \[lit-probe\] forced 5 equiv 0 impl 4 scc-equiv 2
c CHECK-L: Fixed values
c CHECK-L: x(1) + 1
c CHECK-L: x(2)
c CHECK-L: x(7) + 1
c CHECK-L: x(8) + 1
c CHECK-L: x(9)
c CHECK-L: Equivalences
c CHECK-L: x(4) + x(3)
c CHECK-L: x(6) + x(5) + 1
