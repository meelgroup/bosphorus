c RUN: %solver --anfread %s --anfwrite /dev/stdout --gb 1 --xl 0 --el 0 --sat 0 --binomred 0 --shorten 0 --probe 0 --faccanon 0 --facres 0 | %OutputCheck %s
c RUN: %solver --anfread %s --solve --allsol --verb 0 --gb 1 | %verify allsol %s
c
c x3*(x1*x2 + x3) + x1*(x2*x3 + x1) = x3 + x1: the S-polynomial of the two
c equations is linear, so the Groebner basis of the window contains x1 + x3,
c which becomes an equivalence.
x1*x2 + x3
x2*x3 + x1
x4*x5 + x6 + x7
c CHECK: \[gb-window\] .* new 1
c CHECK-L: Equivalences
c CHECK-L: x(3) + x(1)
